{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    // Requis pour un projet référencé (TS6306/TS6310) : sans `composite`,
    // `tsc -b` refuse de construire le projet racine.
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./.tsbuild/node",
    "tsBuildInfoFile": "./.tsbuild/node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
