{
  "name": "plateforme-educative-functions",
  "version": "1.0.0",
  "description": "Cloud Functions pour plateforme scolaire sécurisée",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint --ext .ts src/",
    "lint:fix": "eslint --ext .ts src/ --fix",
    "test": "jest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "pdfkit": "^0.15.0",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "twilio": "^5.3.3",
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "@types/exceljs": "^0.5.3",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.13.9",
    "@types/twilio": "^2.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "eslint-config-google": "^0.14.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "private": true
}
