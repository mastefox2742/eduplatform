// ============================================================
// FIREBASE FIRESTORE SECURITY RULES
// Plateforme éducative - Protection données élèves mineurs
// Version: 2.0 - Conforme RGPD
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================================================
    // FONCTIONS HELPER - Vérification des identités et rôles
    // ===========================================================

    // Vérifie qu'un utilisateur est authentifié et protégé par App Check
    function isAuthenticated() {
      // Note: request.app != null is used to verify App Check
      return request.auth != null && request.auth.uid != null && request.app != null;
    }

    // Récupère le rôle depuis les Custom Claims Firebase Auth
    // Les Custom Claims sont signés par Firebase - infalsifiables côté client
    function getRole() {
      return request.auth.token.role;
    }

    // Récupère l'ID d'école depuis les Custom Claims
    function getSchoolId() {
      return request.auth.token.schoolId;
    }

    // Vérifie si l'utilisateur est directeur (super admin de l'école)
    function isDirection() {
      return isAuthenticated() && getRole() == 'direction';
    }

    // Vérifie si l'utilisateur est professeur
    // UserRole.TEACHER = 'teacher' (enum shared-types)
    function isProfesseur() {
      return isAuthenticated() && getRole() == 'teacher';
    }

    // Vérifie si l'utilisateur est élève
    // UserRole.STUDENT = 'student' (enum shared-types)
    function isEleve() {
      return isAuthenticated() && getRole() == 'student';
    }

    // Vérifie que l'utilisateur appartient à l'école du document
    function isSameSchool(schoolId) {
      return isAuthenticated() && getSchoolId() == schoolId;
    }

    // Direction de la même école
    function isDirectionSameSchool(schoolId) {
      return isDirection() && isSameSchool(schoolId);
    }

    // Professeur de la même école
    function isProfesseurSameSchool(schoolId) {
      return isProfesseur() && isSameSchool(schoolId);
    }

    // L'utilisateur accède à son propre document
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Vérifie que le document appartient à l'école de l'utilisateur
    function documentBelongsToMySchool() {
      return isAuthenticated()
        && resource.data.schoolId == getSchoolId();
    }

    // Vérifie les données entrantes (prévient l'injection de schoolId incorrect)
    function incomingDataBelongsToMySchool() {
      return isAuthenticated()
        && request.resource.data.schoolId == getSchoolId();
    }

    // Vérifie qu'un champ n'est pas modifié (immutabilité)
    function fieldNotChanged(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys());
    }

    // Vérifie qu'aucun champ sensible n'est inclus dans l'écriture
    function noSensitiveFields() {
      return !('password' in request.resource.data)
        && !('token' in request.resource.data)
        && !('nationalId' in request.resource.data);
    }

    // Vérifie les limites de taille des champs texte (anti-injection)
    function textFieldsWithinLimits() {
      return (!('title' in request.resource.data) || request.resource.data.title.size() <= 200)
        && (!('description' in request.resource.data) || request.resource.data.description.size() <= 2000)
        && (!('body' in request.resource.data) || request.resource.data.body.size() <= 5000);
    }

    // ===========================================================
    // COLLECTION : users
    // Profils utilisateurs (direction, professeurs, élèves)
    // ===========================================================
    match /users/{uid} {
      // Lecture : chaque utilisateur lit son propre profil
      //           la direction lit les profils de son école
      //           les professeurs lisent les profils de leur école (limité)
      allow read: if isOwner(uid)
        || isDirectionSameSchool(resource.data.schoolId)
        || (isProfesseurSameSchool(resource.data.schoolId)
            && resource.data.role == 'student');  // Profs voient seulement les élèves

      // Création : uniquement via Cloud Functions (onCreateUser trigger)
      // Les clients ne peuvent pas créer directement des profils utilisateurs
      allow create: if false;

      // Mise à jour : limitée selon le rôle
      allow update: if isOwner(uid)
        && fieldNotChanged('role')           // Un user ne peut pas changer son rôle
        && fieldNotChanged('schoolId')       // Ni son école
        && fieldNotChanged('uid')            // Ni son uid
        && noSensitiveFields()
        && textFieldsWithinLimits()
        // La direction peut modifier tout sauf le uid
        || (isDirectionSameSchool(resource.data.schoolId)
            && fieldNotChanged('uid')
            && noSensitiveFields());

      // Suppression : uniquement via Cloud Functions (RGPD)
      allow delete: if false;
    }

    // ===========================================================
    // COLLECTION : students
    // Profils élèves (données non sensibles)
    // ===========================================================
    match /students/{studentUid} {
      // Lecture :
      // - L'élève lit son propre profil
      // - La direction de l'école lit tous les élèves
      // - Les professeurs lisent les élèves de leurs classes
      allow read: if isOwner(studentUid)
        || isDirectionSameSchool(resource.data.schoolId)
        || (isProfesseurSameSchool(resource.data.schoolId) && resource.data.classeId == request.auth.token.classeId);

      // Création : uniquement via Cloud Function generateStudentCredentials
      allow create: if false;

      // Mise à jour : limitée
      allow update: if isDirectionSameSchool(resource.data.schoolId)
        && fieldNotChanged('uid')
        && fieldNotChanged('studentId')
        && fieldNotChanged('schoolId')
        && fieldNotChanged('createdBy')
        && fieldNotChanged('createdAt')
        && noSensitiveFields();

      // Suppression : uniquement via Cloud Function (RGPD)
      allow delete: if false;

      // -------------------------------------------------------
      // SOUS-COLLECTION : students/{studentUid}/private
      // Données SENSIBLES chiffrées (date de naissance, contacts parents)
      // Accès STRICTEMENT restreint
      // -------------------------------------------------------
      match /private/{document} {
        // Lecture : UNIQUEMENT la direction
        // Les élèves eux-mêmes n'ont pas accès direct (passent par une Cloud Function)
        // Les professeurs n'ont JAMAIS accès aux données privées
        allow read: if isDirectionSameSchool(
          get(/databases/$(database)/documents/students/$(studentUid)).data.schoolId
        );

        // Écriture : uniquement via Cloud Functions
        allow write: if false;
      }
    }

    // ===========================================================
    // COLLECTION : courses
    // Cours créés par les professeurs
    // ===========================================================
    match /courses/{courseId} {
      // Lecture : tous les membres de l'école, avec restriction pour les élèves
      allow read: if documentBelongsToMySchool()
        && (isDirection()
            || isProfesseur()
            || (isEleve()
                // L'élève ne peut lire que les cours de sa classe publiés
                && resource.data.isPublished == true
                && request.auth.token.classeId in resource.data.classeIds));

      // Création : professeurs et direction de l'école
      allow create: if (isProfesseurSameSchool(request.resource.data.schoolId)
          || isDirectionSameSchool(request.resource.data.schoolId))
        && request.resource.data.teacherId == request.auth.uid  // Doit être l'auteur
        && incomingDataBelongsToMySchool()
        && textFieldsWithinLimits()
        && noSensitiveFields();

      // Mise à jour : auteur du cours ou direction
      // ⚠️ Les parenthèses sont CRITIQUES ici : && a une précédence plus haute que ||
      // Sans elles, fieldNotChanged ne s'applique qu'au bloc direction.
      allow update: if ((resource.data.teacherId == request.auth.uid
          && isProfesseurSameSchool(resource.data.schoolId))
        || isDirectionSameSchool(resource.data.schoolId))
        && fieldNotChanged('schoolId')
        && fieldNotChanged('teacherId')
        && textFieldsWithinLimits();

      // Suppression : auteur ou direction
      allow delete: if (resource.data.teacherId == request.auth.uid
          && isProfesseurSameSchool(resource.data.schoolId))
        || isDirectionSameSchool(resource.data.schoolId);

      // -------------------------------------------------------
      // SOUS-COLLECTION : courses/{courseId}/lessons
      // -------------------------------------------------------
      match /lessons/{lessonId} {
        allow read: if get(/databases/$(database)/documents/courses/$(courseId)).data.schoolId == getSchoolId()
          && (isDirection()
              || isProfesseur()
              || (isEleve()
                  && get(/databases/$(database)/documents/courses/$(courseId)).data.isPublished == true
                  && request.auth.token.classeId in get(/databases/$(database)/documents/courses/$(courseId)).data.classeIds));

        allow write: if (isProfesseurSameSchool(
            get(/databases/$(database)/documents/courses/$(courseId)).data.schoolId)
            && get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid)
          || isDirectionSameSchool(
              get(/databases/$(database)/documents/courses/$(courseId)).data.schoolId);
      }

      // -------------------------------------------------------
      // SOUS-COLLECTION : courses/{courseId}/quizzes
      // -------------------------------------------------------
      match /quizzes/{quizId} {
        allow read: if get(/databases/$(database)/documents/courses/$(courseId)).data.schoolId == getSchoolId()
          && (isDirection()
              || isProfesseur()
              || (isEleve()
                  && get(/databases/$(database)/documents/courses/$(courseId)).data.isPublished == true));

        // Les réponses correctes sont masquées pour les élèves
        // (gérée côté Cloud Function)
        allow write: if isProfesseurSameSchool(
            get(/databases/$(database)/documents/courses/$(courseId)).data.schoolId)
          || isDirectionSameSchool(
              get(/databases/$(database)/documents/courses/$(courseId)).data.schoolId);
      }
    }

    // ===========================================================
    // COLLECTION : progress
    // Progression des élèves par cours
    // ===========================================================
    match /progress/{studentUid}/courses/{courseId} {
      // L'élève lit sa propre progression
      // Les professeurs lisent la progression des élèves de LEUR classe uniquement (anti-IDOR)
      // La direction lit tout
      allow read: if isOwner(studentUid)
        || isDirectionSameSchool(
            get(/databases/$(database)/documents/students/$(studentUid)).data.schoolId)
        || (isProfesseurSameSchool(
            get(/databases/$(database)/documents/students/$(studentUid)).data.schoolId)
            && get(/databases/$(database)/documents/students/$(studentUid)).data.classeId
               == request.auth.token.classeId);

      // Écriture de progression déléguée aux Cloud Functions via Admin SDK.
      // L'élève ne peut PAS écrire directement sa progression côté client
      // (risque de falsification de scores — voir VUL-04).
      allow write: if false;
    }

    // ===========================================================
    // COLLECTION : notifications
    // Notifications push
    // ===========================================================
    match /notifications/{notifId} {
      // Chaque utilisateur lit ses propres notifications
      allow read: if isAuthenticated()
        && resource.data.recipientUid == request.auth.uid
        && documentBelongsToMySchool();

      // Mise à jour : uniquement marquer comme lu (par le destinataire)
      allow update: if isAuthenticated()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead == true;

      // Création et suppression : via Cloud Functions uniquement
      allow create: if false;
      allow delete: if false;
    }

    // ===========================================================
    // COLLECTION : auditLogs
    // Logs d'audit IMMUABLES - personne ne peut écrire ou modifier
    // ===========================================================
    match /auditLogs/{logId} {
      // Lecture : uniquement la direction de l'école concernée
      allow read: if isDirectionSameSchool(resource.data.schoolId);

      // Écriture : INTERDITE côté client (uniquement Cloud Functions via Admin SDK)
      allow write: if false;
    }

    // ===========================================================
    // COLLECTION : _rateLimits, _deletionQueue, _aiUsage
    // Collections internes - accès client totalement interdit
    // ===========================================================
    match /_rateLimits/{document=**} {
      allow read, write: if false;
    }

    match /_deletionQueue/{document=**} {
      allow read, write: if false;
    }

    // File de suppression en cascade (alimentée par Cloud Functions Admin SDK uniquement)
    match /_deleteQueue/{document=**} {
      allow read, write: if false;
    }

    // Compteurs séquentiels pour numéros de reçu (CF Admin SDK uniquement)
    match /_counters/{document=**} {
      allow read, write: if false;
    }

    // Les documents _aiUsage sont stockés sous /_aiUsage/{schoolId}/daily/{date}
    // resource.data.schoolId n'existe pas dans ces documents — on utilise le path param
    match /_aiUsage/{schoolId}/{document=**} {
      allow read: if isDirection() && getSchoolId() == schoolId;
      allow write: if false;
    }

    // ===========================================================
    // COLLECTION : classes
    // Groupes d'élèves
    // ===========================================================
    match /classes/{classeId} {
      allow read: if isSameSchool(resource.data.schoolId)
        && (isDirection() || isProfesseur()
            || (isEleve() && request.auth.token.classeId == classeId));

      allow write: if isDirectionSameSchool(
        ('schoolId' in request.resource.data) ? request.resource.data.schoolId : resource.data.schoolId
      );
    }

    // ===========================================================
    // COLLECTION : schools/{schoolId}/** (multi-tenant)
    // Données organisées par schoolId pour le multi-école
    // ===========================================================

    // ⚠️ SEED : Désactivé en production. Ne jamais réactiver sans audit de sécurité.
    // Le seeding doit passer par l'Admin SDK (scripts hors-bande), jamais côté client.
    function isSeedAllowed() {
      return false;
    }

    match /schools/{schoolId} {
      allow read: if isSameSchool(schoolId) || isSeedAllowed();
      allow write: if isAuthenticated() && getRole() == 'admin';
      allow write: if isSeedAllowed();
    }

    // Élèves (sous-collection school)
    match /schools/{schoolId}/students/{studentId} {
      allow read: if isSameSchool(schoolId)
        && (isDirection() || isProfesseur()
            || (isEleve() && resource.data.id == request.auth.uid));
      allow create, update: if isDirectionSameSchool(schoolId)
        && incomingDataBelongsToMySchool()
        && noSensitiveFields();
      allow delete: if isDirectionSameSchool(schoolId);
      allow write: if isSeedAllowed();
    }

    // Professeurs (sous-collection school)
    match /schools/{schoolId}/teachers/{teacherId} {
      // Les élèves ne peuvent pas lire les données des professeurs
      allow read: if isSameSchool(schoolId) && (isDirection() || isProfesseur());
      allow create, update: if isDirectionSameSchool(schoolId)
        && incomingDataBelongsToMySchool();
      allow delete: if isDirectionSameSchool(schoolId);
      allow write: if isSeedAllowed();
    }

    // Classes (sous-collection school)
    match /schools/{schoolId}/classes/{classId} {
      allow read: if isSameSchool(schoolId);
      allow write: if isDirectionSameSchool(schoolId);
      allow write: if isSeedAllowed();
    }

    // ── Notes / Évaluations ──────────────────────────────────────────────────
    // Chaque document = une évaluation avec le champ grades: { [studentId]: { value, comment } }
    match /schools/{schoolId}/assessments/{assessmentId} {
      // Direction voit tout
      allow read: if isDirectionSameSchool(schoolId);
      // Les profs voient leurs propres évaluations
      allow read: if isProfesseurSameSchool(schoolId)
        && resource.data.teacherId == request.auth.uid;
      // Les élèves lisent uniquement les évaluations de leur propre classe (anti-IDOR)
      // Sans ce filtre, un élève pourrait lire les notes de toute l'école
      allow read: if isEleve() && isSameSchool(schoolId)
        && resource.data.classId == request.auth.token.classeId;

      // Création : prof auteur uniquement
      allow create: if isProfesseurSameSchool(schoolId)
        && request.resource.data.teacherId == request.auth.uid;

      // Mise à jour des notes : prof auteur uniquement
      // (pas de restriction sur status — on gère via la logique applicative)
      allow update: if isProfesseurSameSchool(schoolId)
        && resource.data.teacherId == request.auth.uid;
      // La direction peut modifier (correction, validation)
      allow update: if isDirectionSameSchool(schoolId);

      allow delete: if isDirectionSameSchool(schoolId);
      allow write:  if isSeedAllowed();
    }

    // ── Présences / Attendance ───────────────────────────────────────────────
    // Document ID = {classId}_{YYYY-MM-DD}
    // records: { [studentId]: { status, note? } }
    match /schools/{schoolId}/attendance/{recordId} {
      // Direction lit et écrit tout
      allow read, write: if isDirectionSameSchool(schoolId);
      // Professeur lit ses propres feuilles de présence
      allow read: if isProfesseurSameSchool(schoolId)
        && resource.data.teacherId == request.auth.uid;
      // Professeur crée et met à jour ses propres feuilles
      allow create: if isProfesseurSameSchool(schoolId)
        && request.resource.data.teacherId == request.auth.uid;
      allow update: if isProfesseurSameSchool(schoolId)
        && resource.data.teacherId == request.auth.uid;
      allow write: if isSeedAllowed();
    }

    // ── Bulletins ────────────────────────────────────────────────────────────
    // Workflow : prof soumet → direction valide/rejette → publié → visible parents
    match /schools/{schoolId}/bulletins/{bulletinId} {
      // Direction : accès complet
      allow read, write: if isDirectionSameSchool(schoolId);

      // Professeur : lit ses bulletins, crée (soumission), modifie si rejeté
      allow read: if isProfesseurSameSchool(schoolId)
        && resource.data.teacherId == request.auth.uid;
      allow create: if isProfesseurSameSchool(schoolId)
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.status == 'submitted';
      // Resoumission après rejet : champs identifiants verrouillés, status forcé à 'submitted'
      allow update: if isProfesseurSameSchool(schoolId)
        && resource.data.teacherId == request.auth.uid
        && resource.data.status == 'rejected'
        && request.resource.data.status == 'submitted'   // Ne peut resoumettre qu'en 'submitted'
        && fieldNotChanged('studentId')                   // Impossible de changer l'élève
        && fieldNotChanged('teacherId')                   // Impossible de changer l'auteur
        && fieldNotChanged('classId')                     // Impossible de changer la classe
        && fieldNotChanged('schoolYear');                 // Impossible de changer l'année

      // Parent : lit uniquement les bulletins publiés de son enfant
      allow read: if isAuthenticated() && getRole() == 'parent'
        && isSameSchool(schoolId)
        && resource.data.status == 'published'
        && resource.data.studentId in request.auth.token.childrenIds;

      // Élève : lit son propre bulletin publié
      allow read: if isEleve() && isSameSchool(schoolId)
        && resource.data.status == 'published'
        && resource.data.studentId == request.auth.uid;

      allow write: if isSeedAllowed();
    }

    // ── Messages (threads + sous-collection msgs) ────────────────────────────
    // Thread = conversation entre participants
    match /schools/{schoolId}/messages/{threadId} {
      // Lecture : participants uniquement
      allow read: if isSameSchool(schoolId)
        && request.auth.uid in resource.data.participants;
      // Création : tout membre de l'école peut démarrer un thread
      allow create: if isSameSchool(schoolId)
        && request.auth.uid in request.resource.data.participants;
      // Mise à jour : participants (pour lastMessage, unreadCounts, etc.)
      allow update: if isSameSchool(schoolId)
        && request.auth.uid in resource.data.participants;
      // Direction peut lire tous les threads (modération)
      allow read: if isDirectionSameSchool(schoolId);
      allow delete: if isDirectionSameSchool(schoolId);

      // Sous-collection messages individuels
      match /msgs/{msgId} {
        // Participants du thread peuvent lire et écrire
        allow read, write: if isSameSchool(schoolId)
          && request.auth.uid in get(/databases/$(database)/documents/schools/$(schoolId)/messages/$(threadId)).data.participants;
        // Direction peut lire (modération)
        allow read: if isDirectionSameSchool(schoolId);
      }
    }

    // ── Annonces ────────────────────────────────────────────────────────────
    match /schools/{schoolId}/announcements/{announcementId} {
      // Lecture : tous les membres de l'école
      allow read: if isSameSchool(schoolId);
      // Création et modification : direction uniquement
      allow create, update: if isDirectionSameSchool(schoolId)
        && textFieldsWithinLimits();
      // Marquer comme lu (readBy) : tout membre de l'école
      // On autorise uniquement la mise à jour du champ readBy
      allow update: if isSameSchool(schoolId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow delete: if isDirectionSameSchool(schoolId);
      allow write: if isSeedAllowed();
    }

    // ── Configuration de l'école ─────────────────────────────────────────────
    match /schools/{schoolId}/school_config/{configId} {
      allow read:  if isSameSchool(schoolId);
      allow write: if isDirectionSameSchool(schoolId);
      allow write: if isSeedAllowed();
    }

    // ── Emplois du temps ────────────────────────────────────────────────────
    match /schools/{schoolId}/schedules/{slotId} {
      allow read: if isSameSchool(schoolId);
      allow write: if isDirectionSameSchool(schoolId);
      allow write: if isSeedAllowed();
    }

    // Emplois du temps (sous-collection school)
    match /schools/{schoolId}/schedule/{slotId} {
      allow read: if isSameSchool(schoolId);
      allow write: if isDirectionSameSchool(schoolId);
      allow write: if isSeedAllowed();
    }

    // Cours (sous-collection school)
    match /schools/{schoolId}/courses/{courseId} {
      // Les élèves ne voient que les cours publiés de leur classe (anti-fuite de brouillons)
      allow read: if isSameSchool(schoolId)
        && (isDirection()
            || isProfesseur()
            || (isEleve()
                && resource.data.isPublished == true
                && request.auth.token.classeId in resource.data.classeIds));
      allow create: if isProfesseurSameSchool(schoolId)
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isProfesseurSameSchool(schoolId)
        && resource.data.authorId == request.auth.uid;
      allow update, delete: if isDirectionSameSchool(schoolId);
      allow write: if isSeedAllowed();
    }

    // Exercices (sous-collection school)
    match /schools/{schoolId}/exercises/{exerciseId} {
      // Les élèves ne voient que les exercices publiés assignés à leur classe
      allow read: if isSameSchool(schoolId)
        && (isDirection()
            || isProfesseur()
            || (isEleve()
                && resource.data.isPublished == true
                && request.auth.token.classeId in resource.data.classeIds));
      allow create: if isProfesseurSameSchool(schoolId)
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isProfesseurSameSchool(schoolId)
        && resource.data.authorId == request.auth.uid;
      allow update, delete: if isDirectionSameSchool(schoolId);
      allow write: if isSeedAllowed();
    }

    // Progression élèves (sous-collection school)
    // Les scores sont écrits UNIQUEMENT via Cloud Functions (Admin SDK) pour éviter la falsification
    match /schools/{schoolId}/progress/{progressId} {
      allow read: if isSameSchool(schoolId) && (isDirection() || isProfesseur());
      // Lecture seule pour l'élève : il ne peut PAS modifier son score côté client
      allow read: if isEleve()
        && isSameSchool(schoolId)
        && resource.data.userId == request.auth.uid;
      allow write: if isSeedAllowed();
    }

    // ===========================================================
    // MODULES MÉTIER — Discipline, Devoirs, Gamification, CRM…
    // ===========================================================

    // Discipline (sanctions / mérites)
    match /schools/{schoolId}/discipline/{recordId} {
      allow read: if isSameSchool(schoolId)
        && (isDirection() || isProfesseur()
            || (getRole() == 'parent' && resource.data.parentNotified == true));
      allow write: if false;  // CF uniquement
    }

    // Cahier de textes numérique
    match /schools/{schoolId}/cahierTextes/{cahierId} {
      allow read: if isSameSchool(schoolId) && (isDirection() || isProfesseur());
      allow create: if isProfesseur() && isSameSchool(schoolId)
        && request.resource.data.teacherId == request.auth.uid;
      allow update: if isProfesseur() && isSameSchool(schoolId)
        && resource.data.teacherId == request.auth.uid
        && resource.data.status != 'visa_ok';   // Impossible de modifier après visa
      allow update: if isDirection() && isSameSchool(schoolId)
        && request.resource.data.keys().hasOnly(["status","visaBy","visaAt","visaComment"]);
    }

    // Devoirs
    match /schools/{schoolId}/devoirs/{devoirId} {
      allow read: if isSameSchool(schoolId);
      allow write: if isProfesseur() && isSameSchool(schoolId)
        && request.resource.data.teacherId == request.auth.uid;
    }

    // Soumissions de devoirs (check élève)
    match /schools/{schoolId}/devoirSubmissions/{subId} {
      allow read: if isSameSchool(schoolId)
        && (isProfesseur() || isDirection()
            || (isEleve() && resource.data.studentId == request.auth.uid));
      allow create: if isEleve() && isSameSchool(schoolId)
        && request.resource.data.studentId == request.auth.uid;
    }

    // Gamification XP
    match /schools/{schoolId}/studentXP/{studentId} {
      allow read: if isSameSchool(schoolId);
      allow write: if false;  // CF uniquement
    }

    // Badges individuels
    match /schools/{schoolId}/studentBadges/{badgeId} {
      allow read: if isSameSchool(schoolId)
        && (isDirection() || isProfesseur()
            || (isEleve() && resource.data.studentId == request.auth.uid));
      allow write: if false;  // CF uniquement
    }

    // Demandes de remplacement
    match /schools/{schoolId}/remplacements/{reqId} {
      allow read: if isSameSchool(schoolId) && (isDirection() || isProfesseur());
      allow create: if isProfesseur() && isSameSchool(schoolId)
        && request.resource.data.requesterId == request.auth.uid;
      allow update: if isDirection() && isSameSchool(schoolId)
        && request.resource.data.keys().hasOnly(["status","validatedBy","validatedAt"]);
    }

    // CRM Inscriptions leads
    match /schools/{schoolId}/inscriptionLeads/{leadId} {
      allow read, write: if isDirectionSameSchool(schoolId);
    }

    // Logs de relances
    match /schools/{schoolId}/relanceLogs/{logId} {
      allow read: if isDirectionSameSchool(schoolId);
      allow write: if false;
    }

    // Caisse physique (espèces / chèques)
    match /schools/{schoolId}/cashPayments/{payId} {
      allow read: if isDirectionSameSchool(schoolId);
      allow write: if false;  // CF uniquement
    }

    // Logs de messagerie (WhatsApp / SMS)
    match /schools/{schoolId}/messageLogs/{logId} {
      allow read: if isDirectionSameSchool(schoolId);
      allow write: if false;
    }

    // Annales officielles (globales ou par école)
    match /annales/{annaleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getRole() == 'admin';
    }

    // Fiches pédagogiques générées par IA
    match /schools/{schoolId}/fichesPedagogiques/{ficheId} {
      allow read: if isSameSchool(schoolId) && (isDirection() || isProfesseur());
      allow write: if false;  // CF uniquement
    }

    // ===========================================================
    // MODULES COMMERCIAUX — Paie, Budget, Export, Rapports
    // ===========================================================

    // Jobs d'export (direction lit ses propres jobs)
    match /schools/{schoolId}/exportJobs/{jobId} {
      allow read: if isDirectionSameSchool(schoolId)
        || (isAuthenticated() && isSameSchool(schoolId)
            && resource.data.requestedBy == request.auth.uid);
      allow create: if isDirectionSameSchool(schoolId);
      allow write:  if false;  // mise à jour par CF uniquement
    }

    // Contrats enseignants (lecture prof pour son propre contrat)
    match /schools/{schoolId}/teacherContracts/{contractId} {
      allow read: if isDirectionSameSchool(schoolId)
        || (isProfesseur() && isSameSchool(schoolId)
            && resource.data.teacherId == request.auth.uid);
      allow write: if isDirectionSameSchool(schoolId);
    }

    // Fiches de paie (lecture prof pour sa propre fiche)
    match /schools/{schoolId}/payroll/{payrollId} {
      allow read: if isDirectionSameSchool(schoolId)
        || (isProfesseur() && isSameSchool(schoolId)
            && resource.data.teacherId == request.auth.uid);
      allow write: if false;  // CF uniquement
    }

    // Dépenses (direction uniquement)
    match /schools/{schoolId}/expenses/{expenseId} {
      allow read:  if isDirectionSameSchool(schoolId);
      allow write: if false;  // CF uniquement
    }

    // Lignes budgétaires (direction)
    match /schools/{schoolId}/budgetLines/{lineId} {
      allow read, write: if isDirectionSameSchool(schoolId);
    }

    // Alertes budget (direction)
    match /schools/{schoolId}/budgetAlerts/{alertId} {
      allow read: if isDirectionSameSchool(schoolId);
      allow update: if isDirectionSameSchool(schoolId)
        && request.resource.data.keys().hasOnly(["acknowledged", "acknowledgedAt"]);
      allow write: if false;
    }

    // Rapports ministériels générés
    match /schools/{schoolId}/ministryReports/{reportId} {
      allow read:  if isDirectionSameSchool(schoolId);
      allow write: if false;  // CF uniquement
    }

    // ===========================================================
    // COLLECTION : schools/{schoolId}/receipts
    // Reçus PDF de paiement — générés par Cloud Function uniquement
    // ===========================================================
    match /schools/{schoolId}/receipts/{receiptId} {
      // Un parent ne voit que ses propres reçus
      allow read: if isAuthenticated() && isSameSchool(schoolId)
        && (isDirection()
            || (getRole() == 'parent' && resource.data.parentId == request.auth.uid));
      // Écriture : Cloud Function Admin SDK uniquement
      allow write: if false;
    }

    // ===========================================================
    // RÈGLE DE REFUS PAR DÉFAUT
    // Tout ce qui n'est pas explicitement autorisé est refusé
    // ===========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
